#################################################################################
# Download of historical Hourly RADOLAN Precipitation Grids (RW Product) from DWD
# Data Source: RADOLAN (Radar-Online-Aneichung)
# Downloaded from: https://opendata.dwd.de/climate_environment/CDC/grids_germany/hourly/radolan/historical/bin/
# The historical data cover the period from June 2005 up to the year before last.
# More recent data are available in the recent folder. 
# The script has been tested for data from 2009 onwards.
# Product description: https://www.dwd.de/DE/leistungen/radolan/radolan.html

# Product: RW – hourly precipitation sums from radar data, adjusted to rain gauge observations
# Temporal resolution: 60 min; since 2023 the hourly sums are updated in 10-min intervals
# Spatial resolution: 1 km x 1 km grid covering Germany
# Time zone: UTC
# Units: 1/10 mm (raw values) -> divide by 10 to obtain mm (done in the ExtractRADOLAN script)
# Projection: polar stereographic (central meridian 10.0° E, standard parallel 60.0° N)
# Binary files contain no georeference (no CRS, extent 0-900 cells)
# Georeferencing  will be done in the downstream ExtractRADOLAN script
# Note: RADOLAN products with higher temporal resolution (5, 10 min) exist,
#       but are only quasi-calibrated and therefore of lower quality.

# RADOLAN RW product provides high-quality precipitation data adjusted to station data
# Temporal resolution: 60 min, updated in 10 min intervals (since 2023), spatial resolution: 1 km, timezone: UTC.
# Projection: EPSG-Code 31467 (DHDN / 3-degree Gauss-Kruger zone 4 projection based on Bessel 1841 Ellipsoid)
# higher temporal resolution of RADOLAN data  (5, 10 min) available, though with lower quality (quasi-calibrated)
# Precipitation is provided as hourly sums in 1/10mm -> requires division with 10 (done in the downstream ExtractRADOLAN script)
# for a detailed description, see: https://www.dwd.de/DE/leistungen/radolan/radolan.html

# The script downloads the RW files as monthly .tar.gz archives for a user-defined period (start and end year).
#################################################################################
# Packages required
library("rdwd")
library("stringr")

# Define start and end year, data acquisition and storage is performed in annual slices 
start_year <- 2023
end_year <- 2024

# Define output directory, downloaded precipitation data will be arranged in annual subfolders created by the script
output_dir <- 'Path/To/Store/Downloaded/RADOLAN/Output'

# Download file index
# Build link to the DWD's FTP server
base <- gridbase 
link <- "hourly/radolan/historical/bin" 
# Load indices for available RADOLAN data
index <- indexFTP(link, base = base)

# for-loop to iterate through the years
for (year in c(start_year: end_year)){
  
  # Create directory to save annual slices of RADOLAN precipitation data 
  output_dir_annual <- paste(output_dir, year,sep="/")
  if(!dir.exists(output_dir_annual)){
  dir.create(output_dir_annual)} # create directories for annual data packages
  
  # Extract years from file names
  years_files <- as.numeric(str_extract(index, "(?<=RW)\\d{4}"))
  index_filtered <- index[years_files == year]
  index_filtered <- index_filtered[!is.na(index_filtered)]

files <- dataDWD(
  url = index_filtered, 
  base = base, 
  joinbf = TRUE, 
  dir = output_dir_annual, 
  read = FALSE
  )
} #end of for-loop to iterate through the years

